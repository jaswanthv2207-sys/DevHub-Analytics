# ── DevHub server ────────────────────────────────────────────────────────────
# Copy to `server/.env` (or export in your platform's environment panel).

# HTTP port the Express API listens on.
PORT=4000

# 'development' | 'production'  (production enables secure cookies + strict CORS)
NODE_ENV=development

# Absolute path to the SQLite file. Defaults to server/data/devhub.db
# DATABASE_PATH=/var/data/devhub.db

# Personal access token (classic or fine-grained, public read is enough).
# Raises the REST budget from 60 → 5000 requests/hour and enables GraphQL.
# Get one with: gh auth token
GITHUB_TOKEN=

# Leave alone unless you proxy GitHub (GHE / mock server).
GITHUB_API_BASE=https://api.github.com

# Secret used to sign JWT session cookies. MUST be set in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Set to 'true' behind plain-HTTP local setups only. Defaults to true in production.
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins for cross-origin deploys.
# Leave empty when the Express server also serves the built client (single service).
CORS_ORIGINS=

# Public URL of the app (used in logs and CORS guidance).
APP_URL=http://localhost:5173

# Our own per-IP limiter for the DevHub API (distinct from GitHub's quota).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# Trust X-Forwarded-For from Render/Railway/nginx (auto-enabled in production).
TRUST_PROXY=true
